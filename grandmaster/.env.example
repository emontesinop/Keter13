# ─── Grandmaster AI — environment template ───────────────────────────────
# Copy to grandmaster/.env and fill in. NEVER commit the real .env.

# Server
PORT=8787
# URL where the app is reachable (used for cookies and the Lichess OAuth redirect).
# For iPhone access on your Wi-Fi use your computer's LAN IP, e.g. http://192.168.1.20:8787
PUBLIC_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173

# Security (REQUIRED in production). Generate with:  openssl rand -hex 32
JWT_SECRET=
TOKEN_ENC_KEY=

# Database. Leave empty to use the embedded PostgreSQL (PGlite) stored in DATA_DIR.
# For Postgres/Supabase: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# DATA_DIR=/absolute/path/for/embedded/db   (default: grandmaster/.data)

# AI coach (optional — without it the coach answers in verified "engine mode").
# Anthropic (recommended):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Or any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama...):
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# Chess engine. By default the bundled Stockfish 18 WASM build runs under Node.
# For deeper/faster analysis install a native Stockfish and point to it:
# STOCKFISH_PATH=/usr/local/bin/stockfish
ENGINE_DEPTH=16
ENGINE_POOL=1
ENGINE_THREADS=2
ENGINE_HASH_MB=128
# STOCKFISH_WASM_FLAVOR=single   # full-strength NNUE WASM (113 MB) instead of lite

# Chess.com asks API clients to identify themselves — add a contact (e.g. your email) here.
CHESSCOM_USER_AGENT=GrandmasterAI/0.1 (personal chess training app)

# Lichess OAuth (PKCE — no client secret needed; any unique id works)
LICHESS_CLIENT_ID=grandmaster-ai

# Background jobs
ANALYSIS_WORKER=on
